# Copy to .env and adjust. .env is git-ignored and excluded from the image.
NEX_GDDP_CMIP6_IMAGE=ghcr.io/aashishpanta0/nsdf-nex-gddp-cmip6-dashboard:latest
NEX_GDDP_CMIP6_PLATFORM=linux/amd64
# Host interface the dashboard is published on (127.0.0.1 = this machine only).
NEX_GDDP_CMIP6_BIND_ADDRESS=127.0.0.1
# Port used for both the published host port and the in-container listener.
NEX_GDDP_CMIP6_PORT=12347
# Interface the Panel server binds inside the container; keep 0.0.0.0 so
# Docker port publishing can reach it.
NEX_GDDP_CMIP6_LISTEN_ADDRESS=0.0.0.0
# Allowed WebSocket origin(s); set to the public hostname in production.
NEX_GDDP_CMIP6_ALLOW_WS_ORIGIN=*
NEX_GDDP_CMIP6_DATASET=https://atlantis.sci.utah.edu/mod_visus?dataset=nex-gddp-cmip6
